# Copy to .env and fill in. Never commit .env.

# Postgres (Neon / Supabase free tier works). Leave empty to run without a database.
DATABASE_URL=

# AWS (Bedrock, S3). Prefer IAM roles in deployment; use a profile locally.
AWS_REGION=us-east-1

# Per-session guest cap for LLM tokens (cost control, added in Task 3)
GUEST_TOKEN_CAP=60000
