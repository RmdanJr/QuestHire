{
  "name": "questhire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "check:kiro": "node scripts/check-kiro.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run db:validate && npm run check:kiro",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "framer-motion": "14.12.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-check": "4.10.2",
    "jsdom": "31.0.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
